# ============================================================
# Configurações do Saúde Financeira — Exemplo de Configuração
# ============================================================

# ── Portas dos Containers ───────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8081

# ── Banco de Dados (PostgreSQL) ─────────────────────────────
DB_USER=saude
DB_PASSWORD=saude123
DB_NAME=saude_financeira
DB_PORT=5432

# ── Configurações do Servidor ───────────────────────────────
LOG_LEVEL=info

# ── Provedor de IA (LLM) para Chat e Fatura PDF ─────────────
# Preencha estas variáveis para habilitar IA e importação de PDF
LLM_PROVIDER=openai
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120s
