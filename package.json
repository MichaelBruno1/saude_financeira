{
  "name": "saude-financeira",
  "version": "1.3.22",
  "description": "Aplicação de Saúde Financeira Pessoal Estritamente Local",
  "main": "js/app.js",
  "scripts": {
    "dev": "lite-server",
    "lint": "eslint js/**/*.js",
    "test": "vitest run",
    "build:css": "npx @tailwindcss/cli -i css/app.css -o css/tailwind.min.css --minify",
    "docker:build": "npm run build:css && docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "lite-server": "^2.6.1",
    "tailwindcss": "^4.3.2",
    "vitest": "^1.6.0"
  }
}
