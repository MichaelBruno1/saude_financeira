# ============================================================
# Saúde Financeira — .gitignore
# ============================================================

# ── Dependências ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Builds e distribuição ────────────────────────────────────
dist/
build/
out/
.output/
.nuxt/
.next/

# ── Cache de ferramentas ─────────────────────────────────────
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache

# ── Arquivos de ambiente e segredos ─────────────────────────
# NUNCA versione chaves de API, senhas ou tokens
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets.*.json
llm_config.json

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cobertura de testes ──────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Arquivos temporários ─────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ── Sistema Operacional ──────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── Editores e IDEs ──────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
Session.vim
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# ── Lockfiles opcionais (manter apenas o usado no projeto) ───
# Este projeto usa npm — manter apenas package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Misc ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
.vercel
.netlify
